# Effective configure values also exist when the toolchain uses normal variables.
include("${CMAKE_CURRENT_LIST_DIR}/json.cmake")
set(_codet_identity "{\"format\":1}")
foreach(_key source binary generator build_type)
  if(_key STREQUAL "source")
    set(_value "${CMAKE_SOURCE_DIR}")
  elseif(_key STREQUAL "binary")
    set(_value "${CMAKE_BINARY_DIR}")
  elseif(_key STREQUAL "generator")
    set(_value "${CMAKE_GENERATOR}")
  else()
    set(_value "${CMAKE_BUILD_TYPE}")
  endif()
  _codet_json_string(_value "${_value}")
  string(JSON _codet_identity SET "${_codet_identity}" ${_key} "${_value}")
endforeach()
string(JSON _codet_identity SET "${_codet_identity}" compilers "{}")
foreach(_language C CXX)
  set(_compiler "{}")
  foreach(_key path id version)
    if(_key STREQUAL "path")
      set(_value "${CMAKE_${_language}_COMPILER}")
    elseif(_key STREQUAL "id")
      set(_value "${CMAKE_${_language}_COMPILER_ID}")
    else()
      set(_value "${CMAKE_${_language}_COMPILER_VERSION}")
    endif()
    _codet_json_string(_value "${_value}")
    string(JSON _compiler SET "${_compiler}" ${_key} "${_value}")
  endforeach()
  string(JSON _codet_identity SET "${_codet_identity}" compilers ${_language} "${_compiler}")
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/codet-compiler-identity.json" "${_codet_identity}\n")
