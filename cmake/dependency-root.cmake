include("${CMAKE_CURRENT_LIST_DIR}/json.cmake")

# Inspect normal scope without confusing a same-valued shadow with its cache entry.
# Cache mutation is temporary and entirely inside this function; no callbacks or I/O run here.
function(_codet_dependency_normal defined_output value_output)
  get_property(cached CACHE CODET_DEPENDENCY_ROOT PROPERTY TYPE SET)
  if(cached)
    foreach(property VALUE TYPE HELPSTRING ADVANCED STRINGS)
      get_property(saved_${property}_set CACHE CODET_DEPENDENCY_ROOT PROPERTY ${property} SET)
      get_property(saved_${property} CACHE CODET_DEPENDENCY_ROOT PROPERTY ${property})
    endforeach()
    unset(CODET_DEPENDENCY_ROOT CACHE)
  endif()
  set(normal FALSE)
  set(value "")
  if(DEFINED CODET_DEPENDENCY_ROOT)
    set(normal TRUE)
    set(value "${CODET_DEPENDENCY_ROOT}")
  endif()
  if(cached)
    set(CODET_DEPENDENCY_ROOT "${saved_VALUE}" CACHE STRING "${saved_HELPSTRING}" FORCE)
    foreach(property VALUE TYPE HELPSTRING ADVANCED STRINGS)
      if(saved_${property}_set)
        set_property(CACHE CODET_DEPENDENCY_ROOT PROPERTY ${property} "${saved_${property}}")
      endif()
    endforeach()
  endif()
  set(${defined_output} "${normal}" PARENT_SCOPE)
  set(${value_output} "${value}" PARENT_SCOPE)
endfunction()

function(_codet_select_dependency)
  set(pin "${CMAKE_BINARY_DIR}/CMakeFiles/codet-dependency-selection.json")
  set(reset_hint "reset with -UCODET_DEPENDENCY_ROOT, then reapply -DCODET_DEPENDENCY_ROOT=<path>, or recreate the build directory")
  get_property(cached CACHE CODET_DEPENDENCY_ROOT PROPERTY TYPE SET)
  get_property(cache_type CACHE CODET_DEPENDENCY_ROOT PROPERTY TYPE)
  get_property(cache_help CACHE CODET_DEPENDENCY_ROOT PROPERTY HELPSTRING)
  set(cache_value "$CACHE{CODET_DEPENDENCY_ROOT}")
  set(owned FALSE)
  if(DEFINED CACHE{_CODET_DEPENDENCY_VERSION} OR DEFINED CACHE{_CODET_DEPENDENCY_ORIGIN} OR
     DEFINED CACHE{_CODET_DEPENDENCY_VALUE} OR DEFINED CACHE{_CODET_DEPENDENCY_TOKEN})
    set(owned TRUE)
  endif()
  # An untyped -D replaces the cache type even when its value remains empty.
  # Old empty markers must not silently select another tree on regeneration.
  if(NOT cached OR (cache_value STREQUAL "" AND
      (NOT owned OR "$CACHE{_CODET_DEPENDENCY_VERSION}" STREQUAL "2" OR cache_type STREQUAL "UNINITIALIZED")))
    file(REMOVE "${pin}")
    foreach(property VERSION VALUE ORIGIN TOKEN)
      unset(_CODET_DEPENDENCY_${property} CACHE)
    endforeach()
    set(owned FALSE)
  elseif(owned AND NOT "$CACHE{_CODET_DEPENDENCY_VERSION}" STREQUAL "2")
    message(FATAL_ERROR "Obsolete dependency selection cache metadata in ${CMAKE_BINARY_DIR}/CMakeCache.txt; ${reset_hint}")
  endif()
  set(marker "Codet derived dependency selection [$CACHE{_CODET_DEPENDENCY_TOKEN}]")
  set(readable_marker "Offline dependency sources; empty or -U resets selection. ${marker}")
  set(explicit FALSE)
  if(cached AND NOT cache_value STREQUAL "" AND
     (NOT owned OR "$CACHE{_CODET_DEPENDENCY_ORIGIN}" STREQUAL "explicit" OR
      NOT cache_type STREQUAL "PATH" OR
      (NOT cache_help STREQUAL marker AND NOT cache_help STREQUAL readable_marker) OR
      NOT cache_value STREQUAL "$CACHE{_CODET_DEPENDENCY_VALUE}"))
    set(explicit TRUE)
  endif()
  # Only validate metadata that will be reused. A receipt alone owns no cache entry.
  if(explicit OR NOT owned)
    file(REMOVE "${pin}")
  endif()
  if(owned AND NOT explicit)
    if(NOT "$CACHE{_CODET_DEPENDENCY_ORIGIN}" MATCHES "^(explicit|environment|default)$" OR
       NOT IS_ABSOLUTE "$CACHE{_CODET_DEPENDENCY_VALUE}")
      message(FATAL_ERROR "Invalid dependency selection metadata ${pin}; ${reset_hint}")
    endif()
    if(NOT "$CACHE{_CODET_DEPENDENCY_ORIGIN}" STREQUAL "explicit" AND
       NOT "$CACHE{_CODET_DEPENDENCY_TOKEN}" MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Invalid dependency selection ownership ${pin}; ${reset_hint}")
    endif()
  endif()
  if(EXISTS "${pin}")
    file(READ "${pin}" selection)
    foreach(field format root origin source token)
      string(JSON kind ERROR_VARIABLE error TYPE "${selection}" ${field})
      if(NOT error STREQUAL "NOTFOUND" OR
         (field STREQUAL "format" AND NOT kind STREQUAL "NUMBER") OR
         (NOT field STREQUAL "format" AND NOT kind STREQUAL "STRING"))
        message(FATAL_ERROR "Invalid dependency selection record ${pin}; ${reset_hint}")
      endif()
      string(JSON selection_${field} GET "${selection}" ${field})
    endforeach()
    if(NOT selection_format EQUAL 2 OR NOT selection_source STREQUAL CMAKE_SOURCE_DIR OR
       NOT selection_origin MATCHES "^(environment|default)$" OR
       NOT selection_root STREQUAL "$CACHE{_CODET_DEPENDENCY_VALUE}" OR
       NOT selection_origin STREQUAL "$CACHE{_CODET_DEPENDENCY_ORIGIN}" OR
       NOT selection_token STREQUAL "$CACHE{_CODET_DEPENDENCY_TOKEN}")
      message(FATAL_ERROR "Invalid or obsolete dependency selection record ${pin}; ${reset_hint}")
    endif()
  endif()
  _codet_dependency_normal(has_normal normal_value)
  set(origin "")
  set(token "")
  if(explicit)
    set(value "${cache_value}")
    set(origin "explicit")
  elseif(has_normal AND NOT normal_value STREQUAL "")
    set(value "${normal_value}")
    set(origin "normal")
  elseif(EXISTS "${pin}")
    set(value "${selection_root}")
    set(origin "${selection_origin}")
    set(token "${selection_token}")
  elseif(NOT "$ENV{CODET_DEPENDENCY_ROOT}" STREQUAL "")
    set(value "$ENV{CODET_DEPENDENCY_ROOT}")
    set(origin "environment")
  else()
    set(value "${CMAKE_SOURCE_DIR}/.deps")
    set(origin "default")
  endif()
  set(result "${CMAKE_BINARY_DIR}/CMakeFiles/codet-dependency-root.txt")
  file(REMOVE "${result}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT:STRING=${value}"
    "-DOUTPUT:FILEPATH=${result}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/resolve-dependency-root.cmake"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot resolve dependency root: ${error}")
  endif()
  file(READ "${result}" value)
  if(NOT origin STREQUAL "normal")
    if(origin STREQUAL "explicit")
      file(REMOVE "${pin}")
      unset(_CODET_DEPENDENCY_TOKEN CACHE)
      set(help "Offline dependency sources; empty or -U resets selection")
    else()
      if(token STREQUAL "")
        string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef token)
      endif()
      set(_CODET_DEPENDENCY_TOKEN "${token}" CACHE INTERNAL "Generation receipt identity" FORCE)
      set(help "Offline dependency sources; empty or -U resets selection. Codet derived dependency selection [${token}]")
      set(root "${value}")
      set(source "${CMAKE_SOURCE_DIR}")
      foreach(field root origin source token)
        _codet_json_string(json_${field} "${${field}}")
        # JSON decoding restores dollars; file(GENERATE) never sees a literal $<.
        string(REPLACE "$" "\\u0024" json_${field} "${json_${field}}")
      endforeach()
      file(RELATIVE_PATH relative_pin "${CMAKE_CURRENT_BINARY_DIR}" "${pin}")
      # SEND_ERROR prevents generation; later generator errors may retain the receipt.
      file(GENERATE OUTPUT "${relative_pin}"
        CONTENT "{\"format\":2,\"root\":${json_root},\"origin\":${json_origin},\"source\":${json_source},\"token\":${json_token}}\n")
    endif()
    set(CODET_DEPENDENCY_ROOT "${value}" CACHE PATH "${help}" FORCE)
    set(_CODET_DEPENDENCY_VERSION 2 CACHE INTERNAL "Dependency selection metadata version" FORCE)
    set(_CODET_DEPENDENCY_VALUE "${value}" CACHE INTERNAL "Provisional dependency selection" FORCE)
    set(_CODET_DEPENDENCY_ORIGIN "${origin}" CACHE INTERNAL "Dependency selection origin" FORCE)
  endif()
  set(CODET_DEPENDENCY_ROOT "${value}" PARENT_SCOPE)
endfunction()

_codet_select_dependency()
