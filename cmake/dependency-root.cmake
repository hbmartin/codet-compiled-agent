include("${CMAKE_CURRENT_LIST_DIR}/json.cmake")

# Inspect normal scope without confusing a same-valued shadow with its cache entry.
# Cache mutation is temporary and entirely inside this function; no callbacks or I/O run here.
function(_codet_dependency_normal defined_output value_output)
  get_property(cached CACHE CODET_DEPENDENCY_ROOT PROPERTY TYPE SET)
  if(cached)
    foreach(property VALUE TYPE HELPSTRING ADVANCED STRINGS)
      get_property(saved_${property}_set CACHE CODET_DEPENDENCY_ROOT PROPERTY ${property} SET)
      get_property(saved_${property} CACHE CODET_DEPENDENCY_ROOT PROPERTY ${property})
    endforeach()
    unset(CODET_DEPENDENCY_ROOT CACHE)
  endif()
  set(normal FALSE)
  set(value "")
  if(DEFINED CODET_DEPENDENCY_ROOT)
    set(normal TRUE)
    set(value "${CODET_DEPENDENCY_ROOT}")
  endif()
  if(cached)
    set(CODET_DEPENDENCY_ROOT "${saved_VALUE}" CACHE STRING "${saved_HELPSTRING}" FORCE)
    foreach(property VALUE TYPE HELPSTRING ADVANCED STRINGS)
      if(saved_${property}_set)
        set_property(CACHE CODET_DEPENDENCY_ROOT PROPERTY ${property} "${saved_${property}}")
      endif()
    endforeach()
  endif()
  set(${defined_output} "${normal}" PARENT_SCOPE)
  set(${value_output} "${value}" PARENT_SCOPE)
endfunction()

# Receipts and witnesses are generated only after project configuration succeeds.
function(_codet_dependency_record path prefix)
  file(READ "${path}" record)
  foreach(field ${ARGN})
    string(JSON kind ERROR_VARIABLE error TYPE "${record}" ${field})
    if(NOT error STREQUAL "NOTFOUND" OR
       (field STREQUAL "format" AND NOT kind STREQUAL "NUMBER") OR
       (NOT field STREQUAL "format" AND NOT kind STREQUAL "STRING"))
      message(FATAL_ERROR "Invalid dependency selection record ${path}; ${reset_hint}")
    endif()
    string(JSON value GET "${record}" ${field})
    set(${prefix}_${field} "${value}" PARENT_SCOPE)
  endforeach()
endfunction()

function(_codet_select_dependency)
  set(cache "${CMAKE_BINARY_DIR}/CMakeCache.txt")
  set(pin "${CMAKE_BINARY_DIR}/CMakeFiles/codet-dependency-selection.json")
  set(witness "${CMAKE_BINARY_DIR}/CMakeFiles/codet-dependency-success.json")
  set(reset_hint "reset with -UCODET_DEPENDENCY_ROOT, then reapply -DCODET_DEPENDENCY_ROOT=<path>, or recreate the build directory")
  get_property(cached CACHE CODET_DEPENDENCY_ROOT PROPERTY TYPE SET)
  get_property(cache_type CACHE CODET_DEPENDENCY_ROOT PROPERTY TYPE)
  get_property(cache_help CACHE CODET_DEPENDENCY_ROOT PROPERTY HELPSTRING)
  set(cache_value "$CACHE{CODET_DEPENDENCY_ROOT}")
  # Recognize public ownership without trusting any private field. In particular,
  # a damaged private token must not make unchanged public help look like a -D.
  set(managed FALSE)
  if(cache_help MATCHES "^(Offline dependency sources; empty or -U resets selection\\. )?Codet derived dependency selection \\[([0-9a-f]+)\\]$")
    set(managed TRUE)
    set(public_token "${CMAKE_MATCH_2}")
  endif()
  set(owned "${managed}")
  foreach(field VERSION ORIGIN VALUE TOKEN)
    if(DEFINED CACHE{_CODET_DEPENDENCY_${field}})
      set(owned TRUE)
    endif()
  endforeach()
  if(NOT cached OR (cache_value STREQUAL "" AND (NOT managed OR NOT cache_type STREQUAL "PATH")))
    file(REMOVE "${pin}" "${witness}")
    foreach(field VERSION VALUE ORIGIN TOKEN)
      unset(_CODET_DEPENDENCY_${field} CACHE)
    endforeach()
    set(owned FALSE)
    set(managed FALSE)
  elseif(owned AND NOT "$CACHE{_CODET_DEPENDENCY_VERSION}" STREQUAL "3")
    message(FATAL_ERROR "Obsolete dependency selection cache metadata in ${cache}; ${reset_hint}")
  endif()
  set(explicit FALSE)
  if(cached AND NOT cache_value STREQUAL "" AND
     (NOT owned OR NOT cache_type STREQUAL "PATH" OR NOT managed))
    set(explicit TRUE)
  endif()
  set(committed FALSE)
  if(explicit)
    # A real public override replaces current-format metadata before record parsing.
    file(REMOVE "${pin}" "${witness}")
  elseif(owned)
    string(LENGTH "$CACHE{_CODET_DEPENDENCY_TOKEN}" token_length)
    if(NOT "$CACHE{_CODET_DEPENDENCY_ORIGIN}" MATCHES "^(environment|default)$" OR
       NOT IS_ABSOLUTE "$CACHE{_CODET_DEPENDENCY_VALUE}" OR
       NOT cache_value STREQUAL "$CACHE{_CODET_DEPENDENCY_VALUE}")
      message(FATAL_ERROR "Invalid dependency selection metadata in ${cache} (ORIGIN/VALUE); ${reset_hint}")
    endif()
    if(NOT "$CACHE{_CODET_DEPENDENCY_TOKEN}" MATCHES "^[0-9a-f]+$" OR
       NOT token_length EQUAL 32 OR NOT public_token STREQUAL "$CACHE{_CODET_DEPENDENCY_TOKEN}")
      message(FATAL_ERROR "Invalid dependency selection ownership in ${cache} (TOKEN); ${reset_hint}")
    endif()
    if((EXISTS "${pin}" AND NOT EXISTS "${witness}") OR
       (EXISTS "${witness}" AND NOT EXISTS "${pin}"))
      message(FATAL_ERROR "Incomplete dependency selection success records: ${pin} and ${witness}; ${reset_hint}")
    endif()
    if(EXISTS "${pin}")
      _codet_dependency_record("${pin}" selection format root origin source token)
      _codet_dependency_record("${witness}" success format root origin source token receipt_sha256)
      foreach(prefix selection success)
        if(NOT ${prefix}_format EQUAL 3 OR NOT ${prefix}_source STREQUAL CMAKE_SOURCE_DIR OR
           NOT ${prefix}_root STREQUAL "$CACHE{_CODET_DEPENDENCY_VALUE}" OR
           NOT ${prefix}_origin STREQUAL "$CACHE{_CODET_DEPENDENCY_ORIGIN}" OR
           NOT ${prefix}_token STREQUAL "$CACHE{_CODET_DEPENDENCY_TOKEN}")
          if(prefix STREQUAL "selection")
            set(invalid "${pin}")
          else()
            set(invalid "${witness}")
          endif()
          message(FATAL_ERROR "Invalid or obsolete dependency selection record ${invalid}; ${reset_hint}")
        endif()
      endforeach()
      file(SHA256 "${pin}" receipt_sha256)
      if(NOT success_receipt_sha256 STREQUAL receipt_sha256)
        message(FATAL_ERROR "Dependency selection receipt digest mismatch: ${pin} and ${witness}; ${reset_hint}")
      endif()
      set(committed TRUE)
    endif()
  endif()
  _codet_dependency_normal(has_normal normal_value)
  set(token "")
  if(explicit)
    set(value "${cache_value}")
    set(origin "explicit")
  elseif(has_normal AND NOT normal_value STREQUAL "")
    set(value "${normal_value}")
    set(origin "normal")
  elseif(committed)
    set(value "${selection_root}")
    set(origin "${selection_origin}")
    set(token "${selection_token}")
  elseif(NOT "$ENV{CODET_DEPENDENCY_ROOT}" STREQUAL "")
    set(value "$ENV{CODET_DEPENDENCY_ROOT}")
    set(origin "environment")
  else()
    set(value "${CMAKE_SOURCE_DIR}/.deps")
    set(origin "default")
  endif()
  set(result "${CMAKE_BINARY_DIR}/CMakeFiles/codet-dependency-root.txt")
  file(REMOVE "${result}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT:STRING=${value}"
    "-DOUTPUT:FILEPATH=${result}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/resolve-dependency-root.cmake"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot resolve dependency root: ${error}")
  endif()
  file(READ "${result}" value)
  if(NOT origin STREQUAL "normal")
    if(origin STREQUAL "explicit")
      unset(_CODET_DEPENDENCY_TOKEN CACHE)
      set(help "Offline dependency sources; empty or -U resets selection")
    else()
      if(token STREQUAL "")
        string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef token)
      endif()
      set(_CODET_DEPENDENCY_TOKEN "${token}" CACHE INTERNAL "Generation receipt identity" FORCE)
      set(help "Offline dependency sources; empty or -U resets selection. Codet derived dependency selection [${token}]")
      set(root "${value}")
      set(source "${CMAKE_SOURCE_DIR}")
      foreach(field root origin source token)
        _codet_json_string(json_${field} "${${field}}")
        string(REPLACE "$" "\\u0024" json_${field} "${json_${field}}")
      endforeach()
      set(record "{\"format\":3,\"root\":${json_root},\"origin\":${json_origin},\"source\":${json_source},\"token\":${json_token}}\n")
      string(SHA256 receipt_sha256 "${record}")
      file(RELATIVE_PATH relative_pin "${CMAKE_CURRENT_BINARY_DIR}" "${pin}")
      file(RELATIVE_PATH relative_witness "${CMAKE_CURRENT_BINARY_DIR}" "${witness}")
      # SEND_ERROR prevents generation; later generator errors may retain both.
      file(GENERATE OUTPUT "${relative_pin}" CONTENT "${record}")
      file(GENERATE OUTPUT "${relative_witness}"
        CONTENT "{\"format\":3,\"root\":${json_root},\"origin\":${json_origin},\"source\":${json_source},\"token\":${json_token},\"receipt_sha256\":\"${receipt_sha256}\"}\n")
    endif()
    set(CODET_DEPENDENCY_ROOT "${value}" CACHE PATH "${help}" FORCE)
    set(_CODET_DEPENDENCY_VERSION 3 CACHE INTERNAL "Dependency selection metadata version" FORCE)
    set(_CODET_DEPENDENCY_VALUE "${value}" CACHE INTERNAL "Provisional dependency selection" FORCE)
    set(_CODET_DEPENDENCY_ORIGIN "${origin}" CACHE INTERNAL "Dependency selection origin" FORCE)
  endif()
  set(CODET_DEPENDENCY_ROOT "${value}" PARENT_SCOPE)
endfunction()

_codet_select_dependency()
