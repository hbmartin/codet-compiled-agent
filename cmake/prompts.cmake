# Embed only adapted, deduplicated assets. No generator runtime or external source tree is needed.
set(_manifest_path "${CMAKE_SOURCE_DIR}/prompts/manifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest_path}")
file(READ "${_manifest_path}" _manifest)
set(_header "// Generated from prompts/manifest.json. Do not edit.\n#pragma once\n#include \"codet/prompt.hpp\"\nnamespace codet::bundled_prompts {\n")
string(JSON _count LENGTH "${_manifest}" assets)
math(EXPR _last "${_count} - 1")
foreach(_index RANGE ${_last})
  string(JSON _id MEMBER "${_manifest}" assets ${_index})
  set(_path "${CMAKE_SOURCE_DIR}/prompts/assets/${_id}.md")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
  file(READ "${_path}" _text)
  file(SHA256 "${_path}" _actual)
  if(NOT _actual STREQUAL _id)
    message(FATAL_ERROR "Prompt asset checksum mismatch: ${_path}")
  endif()
  string(FIND "${_text}" ")codet_prompt\"" _collision)
  if(NOT _collision EQUAL -1)
    message(FATAL_ERROR "Prompt raw-string delimiter collision: ${_path}")
  endif()
  string(APPEND _header "inline constexpr char p_${_id}[] = R\"codet_prompt(${_text})codet_prompt\";\n")
endforeach()
function(_prompt_ref output)
  string(JSON _value GET "${_manifest}" ${ARGN})
  if(_value STREQUAL "")
    set(${output} "nullptr" PARENT_SCOPE)
  else()
    set(${output} "p_${_value}" PARENT_SCOPE)
  endif()
endfunction()
string(APPEND _header "inline constexpr PromptEntry entries[] = {\n")
string(JSON _count LENGTH "${_manifest}" models)
math(EXPR _last "${_count} - 1")
foreach(_index RANGE ${_last})
  string(JSON _model MEMBER "${_manifest}" models ${_index})
  _prompt_ref(_instructions models ${_model} instructions)
  _prompt_ref(_default models ${_model} default)
  _prompt_ref(_plan models ${_model} plan)
  _prompt_ref(_on_request models ${_model} approval_on_request)
  _prompt_ref(_never models ${_model} approval_never)
  string(APPEND _header "{\"${_model}\", ${_instructions}, ${_default}, ${_plan}, ${_on_request}, ${_never}},\n")
endforeach()
string(APPEND _header "};\n")
_prompt_ref(_fallback models gpt-5.5 instructions)
if(_fallback STREQUAL "nullptr")
  message(FATAL_ERROR "Missing captured gpt-5.5 fallback instructions")
endif()
string(APPEND _header "inline constexpr auto fallback_instructions = ${_fallback};\n")
foreach(_name compact summary_prefix default plan approval_on_request approval_never)
  _prompt_ref(_ref bundled ${_name})
  string(APPEND _header "inline constexpr auto preset_${_name} = ${_ref};\n")
endforeach()
string(APPEND _header "}\n")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
file(WRITE "${CMAKE_BINARY_DIR}/generated/prompts.hpp" "${_header}")
