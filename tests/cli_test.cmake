file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/workspace")
set(ENV{CODET_HOME} "${TEST_ROOT}/home")
execute_process(COMMAND "${CODET}" --help RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code EQUAL 0 OR NOT output MATCHES "codet exec")
  message(FATAL_ERROR "Help failed: ${code} ${output} ${errors}")
endif()
execute_process(COMMAND "${CODET}" --invalid RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code EQUAL 2 OR NOT output STREQUAL "")
  message(FATAL_ERROR "Invalid argument contract failed")
endif()
execute_process(COMMAND "${CODET}" doctor -C "${TEST_ROOT}/workspace" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code EQUAL 0 OR NOT output MATCHES "\"os_sandbox\": false")
  message(FATAL_ERROR "Doctor failed: ${errors}")
endif()
execute_process(COMMAND "${CODET}" login status RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code EQUAL 1 OR NOT output MATCHES "false")
  message(FATAL_ERROR "Empty credential status failed")
endif()
execute_process(COMMAND "${CODET}" exec --sandbox workspace-write RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code EQUAL 2 OR NOT output STREQUAL "")
  message(FATAL_ERROR "Unsupported OS sandbox was not rejected")
endif()
