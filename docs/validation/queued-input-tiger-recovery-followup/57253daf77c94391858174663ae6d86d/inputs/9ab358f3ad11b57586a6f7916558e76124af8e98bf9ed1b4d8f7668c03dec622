set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_VERSION 8)
set(CMAKE_SYSTEM_PROCESSOR powerpc)
set(CMAKE_OSX_ARCHITECTURES "")
set(CMAKE_C_COMPILER /usr/local/bin/powerpc-apple-darwin8-gcc)
set(CMAKE_CXX_COMPILER /usr/local/bin/powerpc-apple-darwin8-g++)
set(CMAKE_AR /usr/local/bin/powerpc-apple-darwin8-ar)
set(CMAKE_RANLIB /usr/local/bin/powerpc-apple-darwin8-ranlib)
set(CMAKE_INSTALL_NAME_TOOL /usr/local/bin/powerpc-apple-darwin8-install_name_tool)
set(CMAKE_OSX_SYSROOT /usr/local/MacOSX10.4u.sdk)
set(CMAKE_OSX_DEPLOYMENT_TARGET 10.4)
set(CMAKE_SKIP_RPATH TRUE)
set(CODET_TIGERPORTS_PREFIX "/opt/tigr" CACHE STRING "Logical target TigerPorts prefix")
set(CODET_TIGER_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/../build/tiger-sysroot" CACHE PATH "Cross dependency stage")
get_filename_component(CODET_TIGER_SYSROOT "${CODET_TIGER_SYSROOT}" ABSOLUTE)
set(_prefix "${CODET_TIGER_SYSROOT}${CODET_TIGERPORTS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH "${CODET_TIGER_SYSROOT}" "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-m32 -mcpu=750 -isystem ${_prefix}/include/LegacySupport -isystem ${_prefix}/include")
set(CMAKE_CXX_FLAGS_INIT "-m32 -mcpu=750 -isystem ${_prefix}/include/LegacySupport -isystem ${_prefix}/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m32 -mcpu=750 -static-libstdc++ -static-libgcc -L${_prefix}/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-m32 -mcpu=750 -L${_prefix}/lib")
set(CURL_INCLUDE_DIR "${_prefix}/include" CACHE PATH "" FORCE)
set(CURL_LIBRARY "${_prefix}/lib/libcurl.dylib" CACHE FILEPATH "" FORCE)
set(OPENSSL_INCLUDE_DIR "${_prefix}/libexec/openssl3/include" CACHE PATH "" FORCE)
set(OPENSSL_CRYPTO_LIBRARY "${_prefix}/libexec/openssl3/lib/libcrypto.dylib" CACHE FILEPATH "" FORCE)
set(OPENSSL_SSL_LIBRARY "${_prefix}/libexec/openssl3/lib/libssl.dylib" CACHE FILEPATH "" FORCE)
set(ZLIB_INCLUDE_DIR "${_prefix}/include" CACHE PATH "" FORCE)
set(ZLIB_LIBRARY "${_prefix}/lib/libz.dylib" CACHE FILEPATH "" FORCE)
set(SQLite3_INCLUDE_DIR "${_prefix}/include" CACHE PATH "" FORCE)
set(SQLite3_LIBRARY "${_prefix}/lib/libsqlite3.dylib" CACHE FILEPATH "" FORCE)
set(CURSES_INCLUDE_PATH "${_prefix}/include" CACHE PATH "" FORCE)
set(CURSES_LIBRARY "${_prefix}/lib/libncurses.dylib" CACHE FILEPATH "" FORCE)
set(CURSES_FORM_LIBRARY "${_prefix}/lib/libform.dylib" CACHE FILEPATH "" FORCE)
set(EDIT_INCLUDE_DIR "${_prefix}/include" CACHE PATH "" FORCE)
set(EDIT_LIBRARY "${_prefix}/lib/libedit.dylib" CACHE FILEPATH "" FORCE)
